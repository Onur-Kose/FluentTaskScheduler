<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>FluentTaskScheduler</PackageId>
		<Version>0.2.0</Version>
		<Authors>Onur Köse</Authors>
		<Description>Fluent API-based background task scheduler for .NET</Description>
		<PackageTags>scheduler;fluent;dotnet;DSL;background;jobs;task</PackageTags>
		<RepositoryUrl>https://github.com/onur-kose/FluentTaskScheduler</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>

	</PropertyGroup>

	<ItemGroup>
		<None Update="README.md" Pack="true" PackagePath="\" />
		<InternalsVisibleTo Include="FluentTaskScheduler.Tests" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
	</ItemGroup>

</Project>
